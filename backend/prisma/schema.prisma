generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Usuario registrado en la plataforma
model Usuario {
  id              String          @id @default(uuid())
  email           String          @unique
  nombre          String
  password        String
  rol             Rol             @default(CLIENTE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  configuraciones Configuracion[]
  pedidos         Pedido[]

  @@map("usuarios")
}

/// Componente de PC disponible en el catálogo
model Componente {
  id              String                    @id @default(uuid())
  sku             String                    @unique
  nombre          String
  tipo            TipoComponente
  precio          Float
  stock           Int                       @default(0)
  atributos       Json
  imagenUrl       String?
  activo          Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  configuraciones ConfiguracionComponente[]

  @@index([tipo])
  @@index([activo])
  @@map("componentes")
}

/// Configuración de PC armada por el usuario
model Configuracion {
  id              String                    @id @default(uuid())
  nombre          String?
  usuarioId       String?
  precioTotal     Float                     @default(0)
  consumoEstimado Float?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  categoria       String?
  descripcion     String?
  destacada       Boolean                   @default(false)
  esPrearmada     Boolean                   @default(false)
  imagenUrl       String?
  componentes     ConfiguracionComponente[]
  usuario         Usuario?                  @relation(fields: [usuarioId], references: [id])
  pedidos         Pedido[]

  @@map("configuraciones")
}

/// Tabla intermedia: relación muchos-a-muchos entre Configuracion y Componente
model ConfiguracionComponente {
  configuracionId String
  componenteId    String
  componente      Componente    @relation(fields: [componenteId], references: [id], onDelete: Cascade)
  configuracion   Configuracion @relation(fields: [configuracionId], references: [id], onDelete: Cascade)

  @@id([configuracionId, componenteId])
  @@map("configuracion_componentes")
}

/// Pedido realizado por un usuario
model Pedido {
  id                     String         @id @default(uuid())
  usuarioId              String
  configuracionId        String?
  estado                 EstadoPedido   @default(PENDIENTE)
  total                  Float
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  alcaldiaMunicipio      String?
  apellidoMaterno        String?
  apellidoPaterno        String?
  calle                  String?
  ciudad                 String?
  codigoPostal           String?
  colonia                String?
  entreCalles            String?
  estadoEnvio            String?
  nombreDestinatario     String?
  nombreDestinatarioPila String?
  numeroExterior         String?
  numeroInterior         String?
  pais                   String?
  referenciasEnvio       String?
  telefonoAlternativo    String?
  telefonoContacto       String?
  tipoVivienda           TipoVivienda?
  pagos                  Pago[]
  configuracion          Configuracion? @relation(fields: [configuracionId], references: [id])
  usuario                Usuario        @relation(fields: [usuarioId], references: [id])

  @@map("pedidos")
}

/// Registro de pago asociado a un pedido
model Pago {
  id       String     @id @default(uuid())
  pedidoId String
  monto    Float
  metodo   String
  estado   EstadoPago @default(PENDIENTE)
  fecha    DateTime   @default(now())
  pedido   Pedido     @relation(fields: [pedidoId], references: [id])

  @@map("pagos")
}

/// Roles de usuario en la plataforma
enum Rol {
  CLIENTE
  ADMIN
}

/// Tipos de componentes de PC
enum TipoComponente {
  CPU
  MOTHERBOARD
  RAM
  GPU
  ALMACENAMIENTO
  PSU
  GABINETE
  MONITOR
  TECLADO
  MOUSE
  AUDIFONOS
  SILLA
  MOUSEPAD
  WEBCAM
  MICROFONO
  BOCINAS
  ALMACENAMIENTO_EXTRA
}

/// Tipo de vivienda registrada para la dirección de envío
enum TipoVivienda {
  CASA
  DEPARTAMENTO
  OFICINA
  OTRO
}

/// Estados posibles de un pedido
enum EstadoPedido {
  PENDIENTE
  PAGADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

/// Estados posibles de un pago
enum EstadoPago {
  PENDIENTE
  COMPLETADO
  FALLIDO
  REEMBOLSADO
}
